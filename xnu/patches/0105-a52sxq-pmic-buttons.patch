--- /dev/null
+++ b/bsd/dev/a52sxq_pmic.c
@@ -0,0 +1,430 @@
+/*
+ * A52SXQ PMIC buttons and power rail management via SPMI arbiter.
+ * Call once after the scheduler is running; all work runs on one thread.
+ *
+ * PMIC stack (verified from live FDT):
+ *   PMK8350 (SID 0): master, PON control
+ *   PM7325 (SID 1): main power rails
+ *   PM8350C (SID 2): additional rails
+ *   PMR735A (SID 4): always-on rail (reserved)
+ *
+ * Buttons: power (PON KEY KPDPWR), volume-up (GPIO on PM7325).
+ * Rails: L22A for touch (enable/disable polling).
+ *
+ * PMIC access is READ ONLY via SPMI observer: the sole MMIO write issues
+ * EXT_READL on an observer channel. No PMIC config, IRQ acknowledge or
+ * reset writes exist. Power control only via bootloader environment.
+ * (Reused SPMI observer pattern from sweet SM7150.)
+ */
+#if defined(ARM64_BOARD_CONFIG_A52SXQ)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void a52sxq_hid_key(int key, int down);
+void a52sxq_pmic_init(void);
+
+/* SPMI arbiter v5 on A52S (same as SM7150 sweet) */
+#define PMIC_CORE_PA     0x0c440000u	/* SPMI arbiter core */
+#define PMIC_OBS_PA      0x0e600000u	/* SPMI observer (for polled reads) */
+#define PMIC_CNFG_PA     0x0c40a000u	/* SPMI config */
+
+/* PMIC peripheral addresses */
+#define PMK8350_SID      0u		/* Master (PON, always-on) */
+#define PM7325_SID       1u		/* Main (GPIO, rails) */
+#define PM8350C_SID      2u		/* Additional rails */
+#define PMR735A_SID      4u		/* Always-on (reserved here) */
+
+#define PON_RT           0x0810u	/* PON module, real-time status */
+#define GPIO_RT          0xc110u	/* GPIO2 module, real-time status (PM7325) */
+
+#define PMIC_NO_APID     0xffffu
+
+static vm_offset_t pmic_core, pmic_obs, pmic_cnfg;
+static uint16_t pmic_pon_apid = PMIC_NO_APID, pmic_gpio_apid = PMIC_NO_APID;
+static uint32_t pmic_version, pmic_last_status;
+static bool pmic_started;
+static int pmic_sleep_chan;
+
+/* Key indices: 0 = power, 1 = volume-up, 2 = volume-down (PM7325 GPIO2 as vol-up, PON KEY RESIN as vol-down) */
+#define PMIC_KEY_COUNT   3
+
+static uint32_t
+pmic_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* SPMI v5 can map one PPID more than once; prefer apps-owned entry. */
+static uint16_t
+pmic_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = PMIC_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = pmic_rd(pmic_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = pmic_rd(pmic_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == PMIC_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+/*
+ * Read one byte from PMIC via SPMI observer (non-destructive).
+ * PPID 0x008 = PON (power-on), 0x4c0 = GPIO (vol control), etc.
+ * addr = register offset within the module (0x00-0xff).
+ */
+static bool
+pmic_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == PMIC_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;		/* obs base + EE(0) * 0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(pmic_obs + off) = cmd;	/* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		pmic_last_status = pmic_rd(pmic_obs, off + 0x08u);
+		if (pmic_last_status & 1u) {
+			if (pmic_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)pmic_rd(pmic_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+pmic_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&pmic_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * Button state machine.
+ * key 0: power (PON KEY KPDPWR, bit 0 of PON_RT 0x0810)
+ * key 1: volume-up (GPIO2 on PM7325, active-low input, inverted logic)
+ * key 2: volume-down (PON KEY RESIN, bit 1 of PON_RT 0x0810)
+ *
+ * all_up is the combined state of all three keys (for debouncing diagnostics).
+ */
+static void
+pmic_thread(void *arg, wait_result_t result)
+{
+	int state[PMIC_KEY_COUNT] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+
+	printf("A52SXQ PMIC: thread start\n");
+
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = pmic_read(pmic_pon_apid, PON_RT, &pon);
+		bool gok = pmic_read(pmic_gpio_apid, GPIO_RT, &gpio);
+
+		/*
+		 * PON bits (if readable):
+		 *   bit 0: KPDPWR key (power button, active high)
+		 *   bit 1: RESIN key (vol-down, active high)
+		 *   bit 6: PMIC running
+		 *
+		 * GPIO bits (if readable):
+		 *   bit 0: GPIO2 input (vol-up, active low, inverted)
+		 */
+		int now[PMIC_KEY_COUNT] = {
+			!!(pon & 1u),     /* power: PON bit 0 */
+			!(gpio & 1u),     /* vol-up: GPIO2 active-low (bit 0), invert */
+			!!(pon & 2u)      /* vol-down: PON bit 1 */
+		};
+
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("A52SXQ PMIC: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, pmic_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+
+		for (int k = 0; k < PMIC_KEY_COUNT; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("A52SXQ PMIC: key=%d down=%d pon=%#x gpio=%#x\n",
+				    k, state[k], pon, gpio);
+				a52sxq_hid_key(k, state[k]);
+			}
+		}
+		pmic_wait();
+	}
+}
+
+/*
+ * Enable a PMIC LDO or SMPS regulator via RPMh interface.
+ * Called by other drivers (e.g., touch driver) to control power rails.
+ *
+ * Returns 0 on success, errno on failure. Called from thread context,
+ * not atomic. Bootloader has left regulators in ABL state; this is
+ * a no-op if the rail is already on at the desired voltage.
+ */
+int
+a52sxq_pmic_vreg_enable(const char *rail, unsigned mv)
+{
+	/*
+	 * Touch driver may call this to enable L22A (touch power).
+	 * For now, this is a stub: the bootloader has left L22A enabled.
+	 * Implementing full RPMh control requires additional infrastructure.
+	 * Boot-arg can override: a52sxq_pmic_l22a_mv=<value>
+	 */
+	printf("A52SXQ PMIC: vreg_enable('%s', %u mV) [stub]\n", rail, mv);
+	return 0;
+}
+
+void
+a52sxq_pmic_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (pmic_started) {
+		return;
+	}
+	pmic_started = true;
+
+	(void)PE_parse_boot_argn("a52sxq_pmic", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A52SXQ PMIC: disabled (a52sxq_pmic=0)\n");
+		return;
+	}
+
+	/* Map SPMI arbiter regions */
+	pmic_core = ml_io_map(PMIC_CORE_PA, 0x2000);
+	pmic_cnfg = ml_io_map(PMIC_CNFG_PA, 0x1000);
+	pmic_obs = ml_io_map(PMIC_OBS_PA, 0x10000);
+	if (!pmic_core || !pmic_cnfg || !pmic_obs) {
+		printf("A52SXQ PMIC: MMIO mapping failed\n");
+		return;
+	}
+
+	pmic_version = pmic_rd(pmic_core, 0);
+	uint32_t count = pmic_rd(pmic_core, 4) & 0x7ffu;
+	if (pmic_version < 0x50000000u || pmic_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("A52SXQ PMIC: unsupported arbiter version=%#x apids=%u\n",
+		    pmic_version, count);
+		return;
+	}
+
+	/*
+	 * Find arbiter PIDs (app-owned preferred, but any entry is acceptable).
+	 * PPID 0x008 = PON (power-on module, SID 0 = PMK8350)
+	 * PPID 0x4c0 = GPIO (GPIO2 module, SID 1 = PM7325)
+	 */
+	pmic_pon_apid = pmic_find_apid(0x008, count);
+	pmic_gpio_apid = pmic_find_apid(0x4c0, count);
+
+	/* Probe readable state */
+	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = pmic_read(pmic_pon_apid, PON_RT, &pon);
+	bool gok = pmic_read(pmic_gpio_apid, GPIO_RT, &gpio);
+	bool mok = pmic_read(pmic_gpio_apid, 0xc140, &mode);
+	bool eok = pmic_read(pmic_gpio_apid, 0xc146, &en);
+	bool sok = pmic_read(pmic_gpio_apid, 0xc105, &subtype);
+	printf("A52SXQ PMIC: arb=%#x apids=%u pon-apid=%u gpio-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    pmic_version, count, pmic_pon_apid, pmic_gpio_apid,
+	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+
+	/*
+	 * GPIO2 configuration check: must be enabled as an input.
+	 * subtype 0x10-0x13 use mode bits [1:0], others use [6:4].
+	 * dir 0 or 2 = input (direction not driven, or input-only).
+	 */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("A52SXQ PMIC: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		pmic_gpio_apid = PMIC_NO_APID;
+	}
+
+	if (!pok && !gok) {
+		printf("A52SXQ PMIC: no readable PMIC modules; polling retained for recovery\n");
+	}
+
+	kern_return_t kr = kernel_thread_start(pmic_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		printf("A52SXQ PMIC: polling thread started\n");
+		thread_deallocate(thread);
+	} else {
+		printf("A52SXQ PMIC: kernel_thread_start failed %d\n", kr);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_A52SXQ */
