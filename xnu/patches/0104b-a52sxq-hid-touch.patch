+/*
+ * A52SXQ touch driver entry point (same interface as sweet_hid_touch).
+ * Called by bsd/dev/a52sxq_touch.c to report touch events as HID digitizer.
+ */
+extern "C" void
+a52sxq_hid_touch(int finger, int down, int x, int y)
+{
+	if (gSweetTouch) {
+		mach_timespec_t ts;
+		clock_get_uptime(&ts);
+		IOHIDEvent *event = IOHIDEvent::digitizerEvent(ts.tv_nsec,
+		    finger,
+		    kIOHIDDigitizerTransducerTypeFinger,
+		    down ? true : false,
+		    0,              // no buttons
+		    x,
+		    y,
+		    0,              // tip pressure
+		    0,              // aux pressure
+		    0);             // twist
+		gSweetTouch->dispatchEvent(event);
+	}
+}
