diff --git a/bsd/dev/a52sxq_touch.c b/bsd/dev/a52sxq_touch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/a52sxq_touch.c
@@ -0,0 +1,540 @@
+/*
+ * A52SXQ SE8 FIFO I2C / STM stm_ts bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware and powered touch rail (L22A from RPMh).
+ * No firmware/config upload, RPMh votes or PMIC writes via this driver.
+ * Only IC data read: report polling and event status reset.
+ * (Reused polling structure from sweet SM7150, adapted for STM protocol.)
+ */
+#if defined(ARM64_BOARD_CONFIG_A52SXQ)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void a52sxq_hid_touch(int finger, int down, int x, int y);
+void a52sxq_touch_init(void);
+
+#define TOUCH_SE_PA      0x00a94000u	/* SE8: STM I2C */
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_NORTH_PA   0x03900000u	/* DT TLMM + NORTH (0x500000) */
+#define TOUCH_GCC_VOTE   0x5200cu
+#define TOUCH_RCG        0x18158u	/* wrapper1 LOCAL S2 = global SE8 */
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+
+/* GENI SE registers (same across all SE instances) */
+#define SE_STATUS        0x040u
+#define SE_MCLK          0x048u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_DMA           0x258u
+#define SE_TX_LEN        0x26cu
+#define SE_RX_LEN        0x270u
+#define SE_SCL           0x278u
+#define SE_CMD           0x600u
+#define SE_CTRL          0x604u
+#define SE_IRQ           0x610u
+#define SE_IRQ_EN        0x614u
+#define SE_IRQ_CLR       0x618u
+#define SE_TX            0x700u
+#define SE_RX            0x780u
+#define SE_TX_COUNT      0x800u
+#define SE_RX_COUNT      0x804u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+#define SE_DONE          (1u << 0)
+#define SE_NACK          (1u << 10)
+#define SE_ERRORS        (0x0eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                          (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS        (SE_DONE | SE_ERRORS | (1u << 5) | (1u << 26) | \
+                          (1u << 27) | (1u << 30))
+
+/* STM stm_ts protocol: 0x49 on I2C SE8 */
+#define STM_ADDR         0x49u
+#define STM_XY_DATA      0xd7u	/* Report (10 bytes): status, touch count, finger data */
+#define STM_MAX_TOUCH    5u		/* STM can report up to 5 fingers */
+#define STM_FIFO_MAX     128u		/* Safety limit on reads */
+
+/* STM coordinate range from device specs */
+#define STM_MAX_X        1080u
+#define STM_MAX_Y        2400u
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead;
+	int irq_hint;
+	uint32_t irq_status, active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		/* Set the output latch before enabling output, avoiding a reset pulse. */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) | 2u);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/* Vote on only wrapper1 and SE8, preserving other clock users. */
+	uint32_t mask = (0x0fu << 18) | (1u << 24);	/* SE8 bit differs from SE7 */
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	printf("A52SXQ TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, TOUCH_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("A52SXQ TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+			printf("A52SXQ TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, 0x18154};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("A52SXQ TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("A52SXQ TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("A52SXQ TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE8 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	unsigned sent = 0, got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_rd(st.se, SE_IRQ);
+		st.irq_status = irq;
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_rd(st.se, SE_IRQ);
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !sent && (irq & (1u << 30))) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			sent = nt;
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (got == nr && sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & ((1u << 26) | (1u << 27) | (1u << 30)));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	/*
+	 * STM stm_ts uses single-byte addressing (unlike Goodix's 16-bit).
+	 * TX the register pointer, repeated START, then read the data.
+	 */
+	int err = touch_msg(addr, &reg, 1u, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				a52sxq_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			a52sxq_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_stm(void)
+{
+	/*
+	 * STM stm_ts protocol:
+	 * Read 10 bytes from 0xd7 (XY_DATA):
+	 *   [0]: Status byte (bit 7=have data, bit 6=touch timeout, etc.)
+	 *   [1]: Number of touches (0-5, or with_ID bit encoding)
+	 *   [2-9]: First 4 fingers' data (2 bytes each) if present
+	 *
+	 * If more than 4 fingers or variable format, larger reads may be needed.
+	 * For 5 fingers total, this driver may need a different protocol.
+	 * This is a minimal single-read implementation.
+	 */
+	uint8_t buf[10];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	int err = touch_read(STM_ADDR, STM_XY_DATA, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+
+	uint8_t status = buf[0];
+	if (!(status & 0x80u)) {
+		/* No data ready; retain current contacts */
+		return 0;
+	}
+
+	uint8_t ntouch = buf[1] & 0x0fu;	/* Low nibble: count */
+	if (ntouch > STM_MAX_TOUCH) {
+		return EIO;	/* Invalid count */
+	}
+
+	/*
+	 * Parse touch points. STM format per finger (2 bytes each after header):
+	 * Each finger: [0] = ID in upper nibble, event type in lower nibble
+	 *              [1] = X coordinate (MSB), [2] = X (LSB), Y similar
+	 * This is a simplified parsing; the actual device may vary.
+	 * For now, assume standard 2-byte per-touch: X (2 bytes LE), Y (2 bytes LE)
+	 */
+	for (unsigned i = 0; i < ntouch && i < STM_MAX_TOUCH; ++i) {
+		const uint8_t *p = buf + 2u + i * 2u;
+		if (2 + (i + 1) * 2u > sizeof(buf)) {
+			break;	/* Not enough data in the read buffer */
+		}
+
+		/* Parse X, Y coordinates (this assumes LE 16-bit pairs after the header) */
+		uint16_t px = p[0] | ((uint16_t)p[1] << 8);
+		uint16_t py = p[2] | ((uint16_t)p[3] << 8);
+
+		unsigned id = i;	/* Use index as finger ID for now */
+		if (id >= TOUCH_MAX || px > STM_MAX_X || py > STM_MAX_Y || (mask & (1u << id))) {
+			return EIO;	/* Invalid or duplicate */
+		}
+
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static void
+touch_thread(void *arg, wait_result_t w)
+{
+	(void)arg;
+	(void)w;
+
+	printf("A52SXQ TOUCH: thread start\n");
+
+	/* Map SE registers */
+	st.se = ml_io_map(TOUCH_SE_PA, 0x20000);
+	if (!st.se) {
+		printf("A52SXQ TOUCH: cannot map SE8 registers\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	/* Map GCC for clock control */
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x200000);
+	if (!st.gcc) {
+		printf("A52SXQ TOUCH: cannot map GCC registers\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	/* Map GPIO for reset line control (if needed) */
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x500000);
+	if (!st.gpio) {
+		printf("A52SXQ TOUCH: cannot map GPIO registers\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	/* Enable clocks */
+	if (!touch_clocks()) {
+		printf("A52SXQ TOUCH: clock setup failed\n");
+		thread_terminate(current_thread());
+		return;
+	}
+
+	/* Probe for STM at 0x49 */
+	uint8_t probe[1];
+	int err = touch_msg(STM_ADDR, NULL, 0, probe, 1, false);
+	if (err) {
+		printf("A52SXQ TOUCH: STM not found at 0x%02x (error %d)\n", STM_ADDR, err);
+		thread_terminate(current_thread());
+		return;
+	}
+
+	printf("A52SXQ TOUCH: STM found at 0x%02x\n", STM_ADDR);
+	st.started = true;
+
+	/* Main polling loop */
+	for (unsigned cycle = 0; st.started && !st.dead; ++cycle) {
+		int err = touch_stm();
+		if (err && err != ENOTSUP) {
+			printf("A52SXQ TOUCH: read error %d\n", err);
+		}
+		touch_wait(16);	/* ~60 Hz polling (16 ms) */
+	}
+
+	printf("A52SXQ TOUCH: thread exit\n");
+	thread_terminate(current_thread());
+}
+
+void
+a52sxq_touch_init(void)
+{
+	printf("A52SXQ TOUCH: initializing\n");
+
+	thread_t touch_thread_handle = NULL;
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &touch_thread_handle);
+	if (kr != KERN_SUCCESS) {
+		printf("A52SXQ TOUCH: thread creation failed\n");
+		return;
+	}
+
+	thread_deallocate(touch_thread_handle);
+}
+
+#endif /* ARM64_BOARD_CONFIG_A52SXQ */
