+/*
+ * A52SXQ button driver entry point (same interface as sweet_hid_key).
+ * Called by bsd/dev/a52sxq_pmic.c to report button events as HID key presses.
+ * Keys: 0 = power, 1 = volume-up, 2 = volume-down.
+ */
+extern "C" void
+a52sxq_hid_key(int key, int down)
+{
+	if (!gSweetHID) {
+		return;
+	}
+
+	/*
+	 * Map a52sxq keys to HID usage pages and IDs:
+	 * key 0 (power): Consumer, Power (0xc0 / 0x0030)
+	 * key 1 (vol-up): Consumer, Volume Increment (0xc0 / 0x00e9)
+	 * key 2 (vol-down): Consumer, Volume Decrement (0xc0 / 0x00ea)
+	 */
+	static const uint32_t pages[] = {0xc0, 0xc0, 0xc0};
+	static const uint32_t ids[] = {0x0030, 0x00e9, 0x00ea};
+
+	if (key < 0 || key >= 3) {
+		return;
+	}
+
+	IOHIDEvent *event = IOHIDEvent::buttonEvent(mach_absolute_time(),
+	    pages[key], ids[key], down ? true : false);
+	gSweetHID->dispatchEvent(event);
+}
+
 extern "C" void
 sweet_hid_key(int key, int down)
 {
