diff --git a/bsd/dev/a52sxq_ufs.c b/bsd/dev/a52sxq_ufs.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/a52sxq_ufs.c
@@ -0,0 +1,536 @@
+/*
+ * A52SXQ internal UFS root device (read-only).
+ *
+ * Samsung Galaxy A52s 5G (SM7325): Qualcomm UFS host (UFSHCI 2.1) at 0x01d84000
+ * with interrupt 265. The host is left enabled with the link up by Samsung ABL
+ * bootloader, which loaded our boot image from it. This driver reuses that state:
+ * it points the transfer request list at its own memory (verifying the host took it
+ * before ringing any doorbell) and issues polled SCSI commands, one at a time, to LUN 0.
+ *
+ * It finds one GPT partition by name (boot-arg ufsroot=, default "userdata") and
+ * exposes it as the BSD disk ufsroot0 (rufsroot0), with 512-byte logical sectors
+ * over the device's 4 KiB blocks.
+ *
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command. Writes are refused.
+ * (Same DMA and polling strategy as sweet SM7150.)
+ */
+#if defined(ARM64_BOARD_CONFIG_A52SXQ)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* UFSHCI 2.1 register offsets (same as SM7150 sweet) */
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} au;
+
+static LCK_GRP_DECLARE(a52sxq_ufs_grp, "a52sxq_ufs");
+static LCK_MTX_DECLARE(a52sxq_ufs_lock, &a52sxq_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(au.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(au.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(au.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer.
+ * Read direction only. Returns 0 or an errno.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	struct utrd *utrd = (struct utrd *)(au.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(au.dma + DMA_UCD);
+	uint64_t ucd_pa = au.dma_pa + DMA_UCD, bounce_pa = au.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? 0x40 : 0x00;        /* R: data in */
+	ucd->cmd[2] = au.lun;
+	ucd->cmd[3] = ++au.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	utrd->dw0 = (1u << 28) | ((len ? 2u : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("A52SXQ UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	if (len) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("A52SXQ UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(au.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("A52SXQ UFS: LUN %u has no GPT\n", au.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("A52SXQ UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		au.first_block = first;
+		au.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("A52SXQ UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("A52SXQ UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("A52SXQ UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = au.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("A52SXQ UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+a52sxq_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!au.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+a52sxq_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+a52sxq_ufs_strategy(buf_t bp)
+{
+	lck_mtx_lock(&a52sxq_ufs_lock);
+	if (!au.ready || buf_flags(bp) & B_READ == 0) {
+		buf_seterror(bp, au.ready ? EROFS : ENXIO);
+		buf_biodone(bp);
+	} else {
+		uint64_t offset = buf_blkno(bp) * au.secsize;
+		uint32_t size = buf_count(bp);
+		uint64_t block_offset = offset % UFS_BLOCK;
+		uint64_t block = au.first_block + offset / UFS_BLOCK;
+		uint32_t blocks_to_read = (size + block_offset + UFS_BLOCK - 1) / UFS_BLOCK;
+		if (block + blocks_to_read > au.first_block + au.nblocks) {
+			buf_seterror(bp, EIO);
+			buf_biodone(bp);
+		} else if (ufs_read_blocks(block, blocks_to_read) == 0) {
+			memcpy(buf_dataptr(bp), (const void *)(au.dma + DMA_BOUNCE + block_offset), size);
+			buf_biodone(bp);
+		} else {
+			buf_seterror(bp, EIO);
+			buf_biodone(bp);
+		}
+	}
+	lck_mtx_unlock(&a52sxq_ufs_lock);
+}
+
+static int
+a52sxq_ufs_ioctl(__unused dev_t dev, u_long cmd, __unused caddr_t addr, __unused int flags,
+    __unused struct proc *p)
+{
+	return ENOTTY;
+}
+
+static struct bdevsw a52sxq_ufs_bdevsw = {
+	.d_open = a52sxq_ufs_open,
+	.d_close = a52sxq_ufs_close,
+	.d_strategy = a52sxq_ufs_strategy,
+	.d_ioctl = a52sxq_ufs_ioctl,
+	.d_dump = eno_dump,
+	.d_psize = eno_psize,
+	.d_type = D_DISK,
+};
+
+int
+a52sxq_ufs_rootdev(dev_t *root)
+{
+	char *root_name = "userdata";
+	int error = 0;
+	PE_parse_boot_argn("ufsroot", root_name, 64);
+
+	/* Allocate and map DMA memory */
+	vm_offset_t dma_va;
+	if (kmem_alloc(kernel_map, &dma_va, DMA_SIZE) != KERN_SUCCESS) {
+		printf("A52SXQ UFS: cannot allocate DMA memory\n");
+		return ENOMEM;
+	}
+
+	au.dma = dma_va;
+	ppnum_t ppn = pmap_find_phys(kernel_pmap, dma_va);
+	if (!ppn) {
+		printf("A52SXQ UFS: DMA allocation not physically contiguous\n");
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return ENOMEM;
+	}
+	au.dma_pa = (uint64_t)ppn << PAGE_SHIFT;
+	for (ppn_t i = 1; i < DMA_SIZE / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, dma_va + i * PAGE_SIZE) != ppn + i) {
+			printf("A52SXQ UFS: DMA allocation not physically contiguous\n");
+			kmem_free(kernel_map, dma_va, DMA_SIZE);
+			return ENOMEM;
+		}
+	}
+
+	/* Map UFS host registers (0x01d84000, 0x3000 bytes) */
+	au.regs = ml_io_map(0x01d84000, 0x3000);
+	if (!au.regs) {
+		printf("A52SXQ UFS: cannot map host registers\n");
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return ENOMEM;
+	}
+
+	au.lun = 0;
+	au.tag = 0;
+	au.secsize = 512;
+
+	/* Take over the UFS host from the bootloader */
+	if ((error = ufs_take_over_host()) != 0) {
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return error;
+	}
+
+	/* Query device capacity */
+	uint8_t cdb_rpcap[10] = { 0x25, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+	if ((error = ufs_scsi(cdb_rpcap, sizeof(cdb_rpcap), 8)) != 0) {
+		printf("A52SXQ UFS: READ CAPACITY failed\n");
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return error;
+	}
+	uint32_t capacity_blocks = (uint32_t)(au.dma + DMA_BOUNCE)[0] << 24 |
+	    (uint32_t)(au.dma + DMA_BOUNCE)[1] << 16 |
+	    (uint32_t)(au.dma + DMA_BOUNCE)[2] << 8 |
+	    (uint32_t)(au.dma + DMA_BOUNCE)[3];
+	printf("A52SXQ UFS: capacity %u blocks (%llu MB)\n", capacity_blocks,
+	    ((uint64_t)capacity_blocks * UFS_BLOCK) / (1024 * 1024));
+
+	/* Find the root partition */
+	if ((error = ufs_find_partition(root_name)) != 0) {
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return error;
+	}
+	printf("A52SXQ UFS: partition \"%s\" at block %llu, %llu blocks (%llu MB)\n",
+	    root_name, au.first_block, au.nblocks,
+	    (au.nblocks * UFS_BLOCK) / (1024 * 1024));
+
+	/* Register the device */
+	au.bmajor = bdevsw_isfree(&a52sxq_ufs_bdevsw);
+	if (au.bmajor < 0) {
+		printf("A52SXQ UFS: no free major device number\n");
+		kmem_free(kernel_map, dma_va, DMA_SIZE);
+		return ENOMEM;
+	}
+	bdevsw_add(au.bmajor, &a52sxq_ufs_bdevsw);
+	au.bdev = makedev(au.bmajor, 0);
+	au.ready = true;
+	*root = au.bdev;
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_A52SXQ */
